{
  "name": "@heychurch/team",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.14.0",
  "description": "Hey Church leadership dashboard as a self-hosted team app (Hono + Postgres + PWA)",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "dev": "node --watch --env-file=.env --import tsx src/server.ts",
    "migrate": "node --import tsx src/migrate.ts",
    "import": "node --import tsx scripts/import-data.ts",
    "seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "add-user": "node --import tsx scripts/add-user.ts",
    "vapid": "node --import tsx scripts/vapid.ts",
    "build:dashboard": "node dashboard/i18n/build.cjs dashboard/hey-church-dashboard.source.html dashboard/hey-church-dashboard.html",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@hono/node-server": "^2.1.8",
    "@sentry/node": "^11.11.0",
    "hono": "^4.13.17",
    "jszip": "^3.10.1",
    "node-cron": "^3.0.3",
    "pg": "^8.13.0",
    "tsx": "^4.19.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.0",
    "@types/web-push": "^3.6.4",
    "acorn": "^8.12.0",
    "acorn-walk": "^8.3.0",
    "typescript": "~6.0.3"
  }
}
