# Local process environment for `pnpm dev` from team/app.
# Copy to team/app/.env (gitignored). The server does not use this file.
# Production secrets are TEAM_* in the heychurch code/infra/.env; Compose maps them onto the names below.

APP_URL=http://localhost:3000
NODE_ENV=development
TZ=Europe/Berlin

# team-db from team/infra/docker-compose.dev.yml publishes this database on port 5433.
DATABASE_URL=postgres://hey:hey@localhost:5433/hey

# Empty locally: the login page prints the link instead of sending mail.
RESEND_API_KEY=
RESEND_FROM=Hey Church <team@heylifeapp.de>
SESSION_DAYS=60

# Generate once with `pnpm vapid`. Never change them later.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:office@heychurch.de

# Empty hides the Claude buttons. The real key stays in .env, never in git.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_LIMIT_PER_10_MIN=40

# Client DSN for the heychurch-team Sentry project. Empty disables reporting.
SENTRY_DSN=https://e96d1d27cebe13852a3044da5f1cec77@o4512333845299200.ingest.de.sentry.io/4512368137076816

BRIEFING_DAILY_CRON=30 7 * * 1-6
NOTIFICATIONS_KEEP_PER_PERSON=30
